# Copy to .env on the host (never commit .env).
# See docs/architecture/SAO.md §12.

AZURE_CLIENT_ID=
AZURE_TENANT_ID=common
TOKEN_ENCRYPTION_KEY=

MAILBOX_USER=
MAILBOX_PASSWORD=

POP3_BIND=127.0.0.1
POP3_PORT=110
SMTP_BIND=127.0.0.1
SMTP_PORT=587
ALLOW_LAN=0

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

GRAPH_POLL_SECONDS=120
SPOOL_SCAN_SECONDS=30

DATA_DIR=var
LOG_DIR=logs

# Live operator journey (`make test-e2e`): first run prints a device-code
# prompt (use -s / Makefile already passes -s). Tokens persist in
# var/live-e2e/ (gitignored). Optional Teams chat for Act 4:
# LIVE_TEAMS_CHAT_ID=
